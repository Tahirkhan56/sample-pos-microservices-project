{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 10
  },
  "ReverseProxy": {
    "Routes": {
      "catalog": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/v1/products/{**catch-all}" }
      },
      "inventory": {
        "ClusterId": "inventory",
        "Match": { "Path": "/api/v1/inventory/{**catch-all}" }
      },
      "ordering": {
        "ClusterId": "ordering",
        "Match": { "Path": "/api/v1/orders/{**catch-all}" }
      },
      "payments": {
        "ClusterId": "payments",
        "Match": { "Path": "/api/v1/payments/{**catch-all}" }
      }
    },
    "Clusters": {
      "catalog": {
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:15", "Path": "/health/ready" } },
        "Destinations": { "primary": { "Address": "http://localhost:5101" } }
      },
      "inventory": {
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:15", "Path": "/health/ready" } },
        "Destinations": { "primary": { "Address": "http://localhost:5102" } }
      },
      "ordering": {
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:15", "Path": "/health/ready" } },
        "Destinations": { "primary": { "Address": "http://localhost:5103" } }
      },
      "payments": {
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:15", "Path": "/health/ready" } },
        "Destinations": { "primary": { "Address": "http://localhost:5104" } }
      }
    }
  }
}
